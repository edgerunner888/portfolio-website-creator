---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="Thanks!" description="Thanks for reaching out." canonicalURL="/thanks">
  <Header currentPage="home" />

  <main class="min-h-screen flex items-center justify-center pt-16">
    <div class="container text-center">
      <div class="w-20 h-20 bg-brand-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-brand-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <h1 class="heading-1 text-slate-900 mb-4">Thanks for Reaching Out!</h1>
      <p class="text-body max-w-xl mx-auto mb-8">
        I&apos;ve received your message and will get back to you within 24 hours (usually much faster).
        In the meantime, feel free to check out my recent work or read about my process.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#work" class="btn-primary">View My Work</a>
        <a href="/" class="btn-outline">Back Home</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>