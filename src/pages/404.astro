---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="404 - Page Not Found" description="Page not found" canonicalURL="/404">
  <Header currentPage="home" />

  <main class="min-h-screen flex items-center justify-center pt-16">
    <div class="container text-center">
      <h1 class="text-9xl font-display font-bold text-brand-200 mb-4">404</h1>
      <h2 class="heading-1 text-slate-900 mb-4">Page Not Found</h2>
      <p class="text-body max-w-xl mx-auto mb-8">
        Sorry, we couldn&apos;t find the page you&apos;re looking for. It might have been moved or doesn&apos;t exist.
      </p>
      <a href="/" class="btn-primary inline-flex">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </div>
  </main>

  <Footer />
</Layout>