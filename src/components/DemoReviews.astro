---
interface Review {
  initials: string;
  rating: number;
  text: string;
  date: string;
  service?: string;
}
interface Props {
  reviews: Review[];
}
const { reviews } = Astro.props;

function getColorFromInitials(initials: string) {
  const colors = [
    '#ea580c', '#0f766e', '#c2410c', '#14b8a6', '#9a3412', '#0d9488',
  ];
  let hash = 0;
  for (let i = 0; i < initials.length; i++) {
    hash = initials.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}
---

<section id="reviews" class="demo-section bg-white" aria-labelledby="reviews-heading">
  <div class="demo-container">
    <header class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-teal-100 text-teal-700 text-sm font-medium mb-4">Testimonials</span>
      <h2 id="reviews-heading" class="demo-heading-2 text-stone-900 mb-4">
        Trusted by Neighbors
      </h2>
      <p class="demo-body">
        Real reviews from real customers in your community. We\'re proud of every 5-star rating.
      </p>
    </header>

    <div class="grid gap-8 lg:grid-cols-3">
      {reviews.map((review) => {
        const bgColor = getColorFromInitials(review.initials);
        return (
          <article class="demo-card p-8">
            <div class="flex items-center gap-2 mb-4" role="img" aria-label={`${review.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class="w-5 h-5 {i < review.rating ? 'text-amber-400 fill-current' : 'text-stone-300'}" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            {review.service && (
              <span class="inline-block px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-medium mb-4">
                {review.service}
              </span>
            )}
            <p class="demo-body mb-6">"{review.text}"</p>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-semibold text-sm flex-shrink-0" style={`background-color: ${bgColor}`}>
                {review.initials}
              </div>
              <div>
                <p class="font-medium text-stone-900">Verified Client</p>
                <p class="text-sm text-stone-500">{review.date}</p>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="text-center mt-14">
      <a href="#" class="demo-btn-outline inline-flex" target="_blank" rel="noopener noreferrer">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 8.299c-1.418-1.275-2.471-1.967-3.471-1.967-.971 0-1.947.31-2.751.931C13.372 6.7 12.423 6.299 11.345 6.299c-1.034 0-1.958.383-2.664 1.031-.828-.645-1.813-.961-2.794-.961-1.01 0-2.082.708-3.51 1.999C1.083 8.959 0 10.404 0 12.042 0 15.522 2.94 18.44 6.725 19.677c.36.126.72.198 1.08.198.36 0 .703-.074 1.023-.207.277-.111.554-.238.834-.378 2.12.659 3.871-.454 3.871-2.844 0-2.386-1.673-4.342-3.871-3.466.314-.144.613-.288.927-.456.436-.233.857-.432 1.26-.595.354-.137.722-.24 1.09-.308.791.051 1.558-.074 2.267-.456.73-.393 1.437-.905 2.117-1.523C19.067 8.953 21 7.067 21 4.836c0-1.835-.784-3.432-2.059-4.456z"/>
        </svg>
        Read More on Google
      </a>
    </div>
  </div>
</section>