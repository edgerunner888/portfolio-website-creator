---
interface Props {
  businessName: string;
  description: string;
  stats: { label: string; value: string }[];
  photo?: string;
  yearsInBusiness: number;
}
const { businessName, description, stats, photo, yearsInBusiness } = Astro.props;
---

<section id="about" class="demo-section bg-stone-50" aria-labelledby="about-heading">
  <div class="demo-container">
    <div class="grid gap-12 lg:grid-cols-2 items-center">
      <div class="lg:order-2">
        <span class="inline-block px-4 py-1.5 rounded-full bg-teal-100 text-teal-700 text-sm font-medium mb-4">About Us</span>
        <h2 id="about-heading" class="demo-heading-2 text-stone-900 mb-5">
          {yearsInBusiness}+ Years of Trusted Service
        </h2>
        <div class="prose prose-stone max-w-none demo-body mb-10">
          <p>{description}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 mb-10">
          {stats.map((stat) => (
            <div class="text-center p-6 bg-white rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-shadow">
              <div class="text-4xl sm:text-5xl font-[Poppins] font-bold text-orange-600">{stat.value}</div>
              <div class="text-sm text-stone-600 mt-2">{stat.label}</div>
            </div>
          ))}
        </div>

        <a href="#contact" class="demo-btn-primary inline-flex">
          Get Your Free Estimate
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="lg:order-1 relative">
        <div class="aspect-[4/3] max-w-xl mx-auto rounded-2xl overflow-hidden bg-stone-100 shadow-2xl">
          {photo ? (
            <img src={photo} alt={`${businessName} team at work`} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-orange-100 to-teal-100 flex items-center justify-center">
              <svg class="w-32 h-32 text-orange-200" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
            </div>
          )}
        </div>
        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-orange-600 rounded-2xl flex items-center justify-center text-white font-[Poppins] font-bold text-3xl opacity-90">
          {yearsInBusiness}+
        </div>
      </div>
    </div>
  </div>
</section>