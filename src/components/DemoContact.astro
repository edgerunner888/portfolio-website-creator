---
interface Props {
  businessName: string;
  phone: string;
  phoneHref: string;
  email: string;
  address: string;
  formEndpoint?: string;
}
const { businessName, phone, phoneHref, email, address, formEndpoint = 'https://formspree.io/f/your-form-id' } = Astro.props;
---

<section id="contact" class="demo-section bg-stone-50" aria-labelledby="contact-heading">
  <div class="demo-container">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="lg:pl-8">
        <span class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-orange-700 text-sm font-medium mb-4">Get In Touch</span>
        <h2 id="contact-heading" class="demo-heading-2 text-stone-900 mb-4">
          Get Your Free Estimate
        </h2>
        <p class="demo-body mb-10">
          Fill out the form or give us a call. We\'ll respond within 15 minutes during business hours.
          No obligation, no pressure — just honest answers.
        </p>

        <div class="space-y-8 mb-10">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-100 to-teal-100 rounded-2xl flex items-center justify-center text-orange-600 flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">Call Us</h3>
              <a href={`tel:${phoneHref}`} class="text-orange-600 hover:underline mt-1 block text-lg">{phone}</a>
              <p class="text-sm text-stone-500 mt-1">Mon-Fri 7am-7pm • Sat 8am-4pm</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-100 to-teal-100 rounded-2xl flex items-center justify-center text-teal-600 flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">Email Us</h3>
              <a href={`mailto:${email}`} class="text-teal-600 hover:underline mt-1 block">{email}</a>
              <p class="text-sm text-stone-500 mt-1">We reply within 2 hours</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-100 to-teal-100 rounded-2xl flex items-center justify-center text-orange-600 flex-shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">Our Location</h3>
              <address class="not-italic text-stone-600 mt-1">{address}</address>
              <p class="text-sm text-stone-500 mt-1">Serving the greater metro area</p>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <span class="demo-trust-badge">Licensed & Insured</span>
          <span class="demo-trust-badge">Free Estimates</span>
          <span class="demo-trust-badge">Satisfaction Guaranteed</span>
          <span class="demo-trust-badge">Background Checked Techs</span>
        </div>
      </div>

      <div class="demo-card p-6 sm:p-8">
        <form action={formEndpoint} method="POST" class="space-y-6" novalidate>
          <input type="hidden" name="_next" value="/thanks" />
          <input type="hidden" name="_subject" value={`New Lead: ${businessName} Website`} />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="demo-label">
                Name <span class="text-orange-600" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="demo-input"
                placeholder="John Smith"
              />
            </div>
            <div>
              <label for="phone" class="demo-label">
                Phone <span class="text-orange-600" aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                class="demo-input"
                placeholder="(555) 123-4567"
              />
            </div>
          </div>

          <div>
            <label for="email" class="demo-label">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              class="demo-input"
              placeholder="john@email.com"
            />
          </div>

          <div>
            <label for="service" class="demo-label">
              Service Needed
            </label>
            <select
              id="service"
              name="service"
              class="demo-input"
            >
              <option value="">Select a service</option>
              <option value="emergency">Emergency Repair</option>
              <option value="installation">Installation / Replacement</option>
              <option value="maintenance">Preventive Maintenance</option>
              <option value="inspection">Inspection / Diagnostics</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="address" class="demo-label">
              Service Address
            </label>
            <input
              type="text"
              id="address"
              name="address"
              class="demo-input"
              placeholder="123 Main St, City, State"
            />
          </div>

          <div>
            <label for="message" class="demo-label">
              Details <span class="text-orange-600" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              class="demo-input resize-y"
              placeholder="Describe the issue, when it started, any error codes, etc."
            ></textarea>
          </div>

          <button
            type="submit"
            class="demo-btn-primary w-full text-lg py-4"
          >
            Get Free Estimate
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </button>

          <p class="text-sm text-stone-500 text-center">
            By submitting, you agree to be contacted about your estimate. We never share your info.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>