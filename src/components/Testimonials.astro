---
interface Testimonial {
  initials: string;
  text: string;
  rating: number;
}
interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;

function getColorFromInitials(initials: string) {
  const colors = [
    '#0ea5e9', '#ed7d1a', '#14b8a6', '#f59e0b', '#8b5cf6', '#ec4899',
    '#ef4444', '#22c55e', '#06b6d4', '#a855f7', '#f97316', '#84cc16'
  ];
  let hash = 0;
  for (let i = 0; i < initials.length; i++) {
    hash = initials.charCodeAt(i) + ((hash << 5) - hash);
  }
  return colors[Math.abs(hash) % colors.length];
}
---

<section id="testimonials" class="section bg-slate-50" aria-labelledby="testimonials-heading">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-16">
      <h2 id="testimonials-heading" class="heading-2 text-slate-900 mb-4">
        What Clients Say
      </h2>
      <p class="text-body">
        Real results from real business owners. <span class="text-brand-600 font-medium">(Demo testimonials — replace with real client feedback)</span>
      </p>
    </header>

    <div class="grid gap-8 lg:grid-cols-3">
      {testimonials.map((testimonial) => {
        const bgColor = getColorFromInitials(testimonial.initials);
        return (
          <article class="card p-6">
            <div class="flex items-center gap-2 mb-4" role="img" aria-label={`${testimonial.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class="w-5 h-5 {i < testimonial.rating ? 'text-amber-400 fill-current' : 'text-slate-300'}" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-body mb-6">"{testimonial.text}"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-semibold text-sm flex-shrink-0" style={`background-color: ${bgColor}`}>
                {testimonial.initials}
              </div>
              <div>
                <p class="font-medium text-slate-900">Verified Client</p>
                <p class="text-sm text-slate-500">Local Business Owner</p>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>