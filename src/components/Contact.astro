---
interface Props {
  email: string;
  formEndpoint?: string;
}
const { email, formEndpoint = 'https://formspree.io/f/your-form-id' } = Astro.props;
---

<section id="contact" class="section bg-slate-50" aria-labelledby="contact-heading">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <header class="text-center mb-12">
        <h2 id="contact-heading" class="heading-2 text-slate-900 mb-4">
          Let&apos;s Build Something
        </h2>
        <p class="text-body">
          Got a project in mind? I&apos;d love to hear about it. Fill out the form or email me directly.
        </p>
      </header>

      <form action={formEndpoint} method="POST" class="space-y-6" novalidate>
        <input type="hidden" name="_next" value="/thanks" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
              Name <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full px-4 py-3 text-slate-900 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
              placeholder="Jane Smith"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
              Email <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 text-slate-900 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
              placeholder="jane@business.com"
            />
          </div>
        </div>

        <div>
          <label for="project-type" class="block text-sm font-medium text-slate-700 mb-2">
            Project Type
          </label>
          <select
            id="project-type"
            name="project_type"
            class="w-full px-4 py-3 text-slate-900 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
          >
            <option value="">Select a project type</option>
            <option value="new-site">New Website</option>
            <option value="redesign">Redesign / Rebuild</option>
            <option value="performance">Performance Optimization</option>
            <option value="seo">Technical SEO</option>
            <option value="maintenance">Maintenance Plan</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label for="budget" class="block text-sm font-medium text-slate-700 mb-2">
            Budget Range
          </label>
          <select
            id="budget"
            name="budget"
            class="w-full px-4 py-3 text-slate-900 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow"
          >
            <option value="">Select a budget range</option>
            <option value="under-3k">$1,500 - $3,000</option>
            <option value="3k-5k">$3,000 - $5,000</option>
            <option value="5k-10k">$5,000 - $10,000</option>
            <option value="10k-plus">$10,000+</option>
            <option value="not-sure">Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
            Tell Me About Your Project <span class="text-brand-600" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full px-4 py-3 text-slate-900 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-shadow resize-y"
            placeholder="What are you looking to build? Who is your audience? Any specific features or integrations needed?"
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn-primary w-full sm:w-auto"
        >
          Send Message
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>

        <p class="text-sm text-slate-500 text-center">
          Or email directly: <a href={`mailto:${email}`} class="text-brand-600 hover:underline">{email}</a>
        </p>
      </form>
    </div>
  </div>
</section>