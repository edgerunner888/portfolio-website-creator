---
interface Props {
  name: string;
  tagline: string;
  ctaText: string;
  ctaHref: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}
const { name, tagline, ctaText, ctaHref, secondaryCtaText, secondaryCtaHref } = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden" aria-labelledby="hero-heading">
  <div class="container relative z-10">
    <div class="max-w-3xl">
      <p class="text-brand-600 font-medium text-sm tracking-wider uppercase mb-4">
        Available for new projects
      </p>
      <h1 id="hero-heading" class="heading-1 text-slate-900 mb-6">
        Hi, I&apos;m <span class="text-brand-600">{name}</span>
      </h1>
      <p class="text-xl sm:text-2xl text-slate-600 mb-8 max-w-2xl">
        {tagline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={ctaHref} class="btn-primary text-center">
          {ctaText}
        </a>
        {secondaryCtaText && secondaryCtaHref && (
          <a href={secondaryCtaHref} class="btn-outline text-center">
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Decorative background elements -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-100/50 rounded-full blur-3xl" />
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-brand-100/50 rounded-full blur-3xl" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-brand-200/50 rounded-full" />
  </div>
</section>