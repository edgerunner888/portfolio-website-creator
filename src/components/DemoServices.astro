---
interface Service {
  title: string;
  description: string;
  icon: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
}
interface Props {
  services: Service[];
}
const { services } = Astro.props;

function getIcon(name: string) {
  switch (name) {
    case 'emergency':
      return `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>`;
    case 'install':
      return `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`;
    case 'maintenance':
      return `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`;
    case 'inspect':
      return `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`;
    default:
      return '';
  }
}
---

<section id="services" class="demo-section bg-white" aria-labelledby="services-heading">
  <div class="demo-container">
    <header class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-orange-700 text-sm font-medium mb-4">What We Do</span>
      <h2 id="services-heading" class="demo-heading-2 text-stone-900 mb-4">
        Services Built Around You
      </h2>
      <p class="demo-body">
        From emergency repairs to full installations, we handle it all with professionalism and care.
        Every job backed by our satisfaction guarantee.
      </p>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <article class="demo-card p-8 h-full flex flex-col group">
          <div class="w-16 h-16 bg-gradient-to-br from-orange-100 to-teal-100 rounded-2xl flex items-center justify-center text-orange-600 mb-5 group-hover:scale-110 transition-transform duration-300" set:html={getIcon(service.icon)} />
          <h3 class="demo-heading-3 text-stone-900 mb-3">{service.title}</h3>
          <p class="demo-body mb-5 flex-1">{service.description}</p>
          <ul class="space-y-3 mb-6" role="list">
            {service.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-stone-600">
                <div class="w-6 h-6 flex-shrink-0 flex items-center justify-center bg-orange-100 rounded-lg">
                  <svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                {feature}
              </li>
            ))}
          </ul>
          {service.ctaText && service.ctaHref && (
            <a href={service.ctaHref} class="demo-btn-primary w-full text-center mt-auto">
              {service.ctaText}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>