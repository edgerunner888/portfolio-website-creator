---
interface Props {
  name: string;
  bio: string;
  skills: string[];
}
const { name, bio, skills } = Astro.props;
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="about-heading" class="heading-2 text-slate-900 mb-6">
        About {name}
      </h2>
      <div class="prose prose-slate max-w-none text-body mb-10">
        <p>{bio}</p>
      </div>
      <div class="flex flex-wrap gap-2 justify-center" role="list" aria-label="Technologies">
        {skills.map((skill) => (
          <span class="text-sm font-medium text-slate-700 bg-slate-100 px-3 py-1 rounded-full" role="listitem">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>